{
  "name": "synapsys-note",
  "version": "1.12.5",
  "private": true,
  "description": "Plataforma de produtividade e gestão de conhecimento (PKM) com editor de blocos, bases de dados flexíveis, notas de voz e importação nativa do Notion sobre Firebase.",
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:sidebar-dnd && npm run verify:page-tree && npm run verify:notebook-tree && npm run verify:media-enrichment && npm run verify:attachment-compress && npm run verify:notion-database-notebook && npm run verify:toggle && npm run verify:image-lightbox && npm run verify:document-title && npm run verify:table-multi && npm run verify:login-attempts && npm run verify:mention-scope && npm run verify:search-scope && npm run verify:language && npm run verify:media-deletion && npm run verify:user-avatar && npm run verify:firebase-admin",
    "verify:sidebar-dnd": "tsx scripts/verify-sidebar-dnd.mts",
    "verify:page-tree": "tsx scripts/verify-page-tree.mts",
    "verify:notebook-tree": "tsx scripts/verify-notebook-tree.mts",
    "verify:media-enrichment": "tsx scripts/verify-media-enrichment.mts",
    "verify:attachment-compress": "tsx scripts/verify-attachment-compress.mts",
    "verify:notion-database-notebook": "tsx scripts/verify-notion-database-notebook.mts",
    "verify:toggle": "tsx scripts/verify-toggle.mts",
    "verify:image-lightbox": "tsx scripts/verify-image-lightbox.mts",
    "verify:document-title": "tsx scripts/verify-document-title.mts",
    "verify:table-multi": "tsx scripts/verify-table-multi.mts",
    "verify:login-attempts": "tsx scripts/verify-login-attempts.mts",
    "verify:mention-scope": "tsx scripts/verify-mention-scope.mts",
    "verify:search-scope": "tsx scripts/verify-search-scope.mts",
    "verify:pdf-export": "tsx scripts/verify-pdf-export.mts",
    "verify:language": "tsx scripts/verify-language-and-translation.mts",
    "verify:media-deletion": "tsx scripts/verify-media-deletion.mts",
    "verify:user-avatar": "tsx scripts/verify-user-avatar.mts",
    "verify:firebase-admin": "tsx --conditions=react-server scripts/verify-firebase-admin.mts",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:web": "firebase deploy --only apphosting:synapsysnote",
    "deploy:secrets:admin": "firebase apphosting:secrets:set FIREBASE_SERVICE_ACCOUNT_JSON --data-file synapsysnote-firebase-adminsdk-fbsvc-b29e1e849c.json --force && firebase apphosting:secrets:grantaccess FIREBASE_SERVICE_ACCOUNT_JSON --backend synapsysnote"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@notionhq/client": "^5.26.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-character-count": "^3.31.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-color": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-mention": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/extension-text-style": "^3.31.0",
    "@tiptap/extension-typography": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/suggestion": "^3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.1.1",
    "google-auth-library": "^10.9.1",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.18.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.39.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "^6.3.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}