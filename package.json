{
  "name": "synapsys-note",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de produtividade e gestão de conhecimento (PKM) com editor de blocos, bases de dados flexíveis, OCR, notas de voz e importação nativa do Notion sobre Firebase.",
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:zip-import && npm run verify:sidebar-dnd && npm run verify:page-tree",
    "verify:zip-import": "tsx scripts/verify-zip-import.mts",
    "verify:sidebar-dnd": "tsx scripts/verify-sidebar-dnd.mts",
    "verify:page-tree": "tsx scripts/verify-page-tree.mts",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@notionhq/client": "^5.26.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-mention": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/suggestion": "^3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.39.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "^6.3.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
