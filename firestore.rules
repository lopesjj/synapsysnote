rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isMember(workspaceId) {
      return isSignedIn() && exists(memberPath(workspaceId));
    }

    function role(workspaceId) {
      return get(memberPath(workspaceId)).data.role;
    }

    function canWrite(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin', 'editor'];
    }

    function isAdmin(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) in ['owner', 'admin'];
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId) && role(workspaceId) == 'owner';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function unchanged(field) {
      return !(field in incoming()) || incoming()[field] == existing()[field];
    }

    // OCR, transcrição e vetores: só Cloud Functions / Admin SDK.
    function hasNoServerFields() {
      return !incoming().keys().hasAny([
        'embedding', 'embeddingUpdatedAt', 'extractedOCRText', 'transcriptText'
      ]);
    }

    function hasNoProvenanceFields() {
      return (!('notionPageId' in incoming()) || incoming().notionPageId == null)
        && (!('importJobId' in incoming()) || incoming().importJobId == null);
    }

    // Importação .zip no cliente marca a origem; o pipeline OAuth usa
    // notionPageId/importJobId (só Admin SDK).
    function validImportSource() {
      return !('importSource' in incoming())
        || incoming().importSource == null
        || incoming().importSource in ['notion-zip', 'evernote', 'docx', 'google-docs', 'html'];
    }

    // Workspace pessoal do usuário (fallback se o Admin não estiver configurado).
    // Workspaces compartilhados só o Admin SDK cria.
    function isPersonalWorkspace(workspaceId) {
      return workspaceId == 'ws_' + request.auth.uid;
    }

    function studyCollections() {
      return [
        'study_plans', 'study_subjects', 'study_sessions', 'study_reviews', 'study_exams',
        'study_cycles', 'study_reminders', 'study_stickies', 'study_meta'
      ];
    }

    function validStudyDoc(collectionName, docId) {
      return (collectionName != 'study_meta' || docId == 'settings')
        && (collectionName != 'study_plans'
          || (incoming().name is string && incoming().name.size() <= 200))
        && (collectionName != 'study_subjects'
          || (incoming().name is string && incoming().name.size() <= 200
            && incoming().topics is list && incoming().topics.size() <= 600))
        && (collectionName != 'study_sessions'
          || (incoming().durationSec is number && incoming().durationSec >= 0
            && incoming().durationSec <= 57600 && incoming().subjectId is string))
        && (collectionName != 'study_exams'
          || (incoming().rows is list && incoming().rows.size() <= 100))
        && (collectionName != 'study_cycles'
          || (incoming().items is list && incoming().items.size() <= 400
            && incoming().history is list && incoming().history.size() <= 800))
        && (collectionName != 'study_stickies'
          || (incoming().html is string && incoming().html.size() <= 200000));
    }

    function serverOnlyUserFields() {
      return ['legalAcceptedVersion', 'legalAcceptedAt', 'sessionRevokedAt'];
    }

    function planPath() {
      return /databases/$(database)/documents/account_plans/$(request.auth.uid);
    }

    function planActive() {
      return !exists(planPath())
        || get(planPath()).data.get('readOnlyAfter', null) == null
        || request.time.toMillis() < get(planPath()).data.readOnlyAfter + 259200000;
    }

    function changedOnly(keys) {
      return incoming().diff(existing()).affectedKeys().hasOnly(keys);
    }

    function notebookLifecycle() {
      return changedOnly(['archived', 'parentId', 'archivedFromParentId', 'deletedAt', 'trashedWith', 'updatedAt']);
    }

    function pageLifecycle() {
      return changedOnly([
        'archived', 'notebookId', 'parentPageId', 'path', 'archivedFromNotebookId',
        'archivedFromParentPageId', 'archivedFromPath', 'deletedAt', 'trashedWith', 'updatedBy', 'updatedAt'
      ]);
    }

    function databaseLifecycle() {
      return changedOnly(['deletedAt', 'trashedWith', 'updatedAt']);
    }

    function validNamed() {
      return incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 200;
    }

    match /account_plans/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;

      match /history/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && incoming().uid == userId
        && !incoming().keys().hasAny(serverOnlyUserFields());
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && incoming().uid == userId
        && !incoming().diff(existing()).affectedKeys().hasAny(serverOnlyUserFields());
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      // get: membro (subcoleção) ou listado em memberIds (consultas).
      allow get: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds
        || isMember(workspaceId)
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && isPersonalWorkspace(workspaceId)
        && incoming().ownerId == request.auth.uid
        && incoming().memberIds.hasOnly([request.auth.uid])
        && incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 120;

      allow update: if isAdmin(workspaceId)
        && incoming().ownerId == existing().ownerId;

      allow delete: if isOwner(workspaceId);

      match /members/{userId} {
        allow read: if isMember(workspaceId);

        // Primeiro membro: o dono se registra depois de criar o workspace.
        // Depois só admin/owner convida.
        allow create: if isSignedIn() && (
          (
            request.auth.uid == userId
            && incoming().role == 'owner'
            && isPersonalWorkspace(workspaceId)
            && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId
              == request.auth.uid
          )
          || (isAdmin(workspaceId) && (incoming().role != 'owner' || isOwner(workspaceId)))
        );

        allow update: if isAdmin(workspaceId)
          && (userId != request.auth.uid || incoming().role == existing().role)
          && !(existing().role == 'owner' && incoming().role != 'owner')
          && (incoming().role != 'owner' || isOwner(workspaceId));

        allow delete: if isAdmin(workspaceId) && existing().role != 'owner';
      }

      match /notebooks/{notebookId} {
        allow read: if isMember(workspaceId);
        allow create: if canWrite(workspaceId) && planActive() && validNamed();
        allow update: if canWrite(workspaceId) && validNamed() && (planActive() || notebookLifecycle());
        allow delete: if canWrite(workspaceId);
      }

      match /pages/{pageId} {
        allow read: if isMember(workspaceId);

        allow create: if canWrite(workspaceId)
          && planActive()
          && incoming().createdBy == request.auth.uid
          && incoming().title is string
          && incoming().title.size() <= 500
          && hasNoServerFields()
          && hasNoProvenanceFields()
          && validImportSource();

        allow update: if canWrite(workspaceId)
          && (planActive() || pageLifecycle())
          && incoming().createdBy == existing().createdBy
          && incoming().updatedBy == request.auth.uid
          && unchanged('extractedOCRText')
          && unchanged('transcriptText')
          && unchanged('embedding')
          && unchanged('embeddingUpdatedAt')
          && unchanged('notionPageId')
          && unchanged('importJobId');

        // Hard delete só admin; o fluxo normal grava deletedAt (update).
        allow delete: if isAdmin(workspaceId);

        match /versions/{versionId} {
          allow read: if isMember(workspaceId);
          allow create: if canWrite(workspaceId) && planActive() && incoming().authorId == request.auth.uid;
          allow update: if false;
          allow delete: if isAdmin(workspaceId);
        }
      }

      match /databases/{databaseId} {
        allow read: if isMember(workspaceId);
        allow create: if canWrite(workspaceId) && planActive() && validNamed();
        allow update: if canWrite(workspaceId) && validNamed() && (planActive() || databaseLifecycle());
        allow delete: if isAdmin(workspaceId);

        match /rows/{rowId} {
          allow read: if isMember(workspaceId);
          allow create, update: if canWrite(workspaceId) && planActive();
          allow delete: if canWrite(workspaceId);
        }
      }

      match /attachments/{attachmentId} {
        allow read: if isMember(workspaceId);
        allow create: if canWrite(workspaceId)
          && planActive()
          && incoming().uploadedBy == request.auth.uid
          && incoming().storagePath.matches('workspaces/' + workspaceId + '/.*');
        allow update: if canWrite(workspaceId)
          && unchanged('ocrText')
          && unchanged('transcript')
          && unchanged('embedding');
        allow delete: if canWrite(workspaceId);
      }

      match /import_jobs/{jobId} {
        allow read: if isMember(workspaceId);

        // Enfileirar e atualizar progresso: só o worker (Admin SDK / API Next).
        allow create: if false;

        allow update: if canWrite(workspaceId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          && incoming().status == 'canceled'
          && existing().status in ['pending', 'discovering', 'running'];

        allow delete: if isAdmin(workspaceId);

        match /logs/{logId} {
          allow read: if isMember(workspaceId);
          allow write: if false;
        }
      }

      match /integrations/{integrationId} {
        allow read: if isMember(workspaceId);
        allow write: if false;

        match /secure/{secretId} {
          allow read, write: if false;
        }
      }

      match /trashed_media/{mediaId} {
        allow read: if isMember(workspaceId);
        allow write: if false;
      }

      match /flashcards/{flashcardId} {
        allow read: if isMember(workspaceId);
        allow create, update: if canWrite(workspaceId) && planActive();
        allow delete: if canWrite(workspaceId);
      }

      match /{studyCollection}/{studyDocId} {
        allow read: if studyCollection in studyCollections() && isMember(workspaceId);
        allow create: if studyCollection in studyCollections()
          && canWrite(workspaceId)
          && (studyCollection == 'study_meta' || planActive())
          && validStudyDoc(studyCollection, studyDocId);
        allow update: if studyCollection in studyCollections()
          && canWrite(workspaceId)
          && validStudyDoc(studyCollection, studyDocId);
        allow delete: if studyCollection in studyCollections() && canWrite(workspaceId);
      }
    }

    match /oauthClients/{clientId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
