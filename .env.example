# =============================================================================
# Synapsys Note — variáveis de ambiente (ETAPA 7)
#
# Copie para `.env.local`. O Web SDK do projeto `synapsysnote` já vem preenchido
# (e também como fallback em `src/lib/firebase/config.ts`). O modo convidado da
# landing page continua local. Para forçar demonstração em toda a sessão:
# NEXT_PUBLIC_USE_LOCAL_DEMO=true
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase (cliente) — projeto `synapsysnote`
#    Estes valores são as chaves PÚBLICAS do Web SDK (não são segredo).
#    O acesso é barrado por Authorized domains + firestore.rules + storage.rules.
#    Para forçar o modo demonstração local: NEXT_PUBLIC_USE_LOCAL_DEMO=true
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCohAmoFuvjw-OXao3a_9yn0b-H22reprw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=synapsysnote.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=synapsysnote
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=synapsysnote.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=391599702512
NEXT_PUBLIC_FIREBASE_APP_ID=1:391599702512:web:f1948d41d3f63ad340dd35
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2ED1GY38CC
NEXT_PUBLIC_FIREBASE_REGION=us-central1
# NEXT_PUBLIC_USE_LOCAL_DEMO=true

# Id do workspace. Deixe em branco (ou "primary") para usar um workspace
# pessoal por usuário (`ws_{uid}`). Só defina um valor fixo se quiser um
# workspace compartilhado entre contas.
# NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=

# Use os emuladores locais em vez do projeto real (firebase emulators:start).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# -----------------------------------------------------------------------------
# 2. Firebase Admin (servidor) — usado pelo callback OAuth do Notion
#    Usado pelo bootstrap do workspace e por toda a importação do Notion
#    (árvore, worker, desconexão). Console > Contas de serviço > Gerar chave.
#    Cole o JSON inteiro em UMA linha.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=synapsysnote.firebasestorage.app

# -----------------------------------------------------------------------------
# 3. Notion OAuth — https://www.notion.so/my-integrations
#    Tipo: Public integration. Redirect URI deve bater exatamente.
# -----------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:43127/api/notion/callback

# -----------------------------------------------------------------------------
# 4. Criptografia dos tokens de terceiros (AES-256-GCM)
#    Gere com: openssl rand -base64 32
#    O MESMO valor precisa existir nas Cloud Functions:
#    firebase functions:secrets:set TOKEN_ENCRYPTION_KEY
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 5. IA (definidas nas Cloud Functions, não no Next.js)
#    firebase functions:secrets:set GEMINI_API_KEY
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# FUNCTIONS_REGION=us-central1
# TRASH_RETENTION_DAYS=30
# IMPORT_MAX_FILE_BYTES=262144000
