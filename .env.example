# =============================================================================
# Synapsys Note — variáveis de ambiente (ETAPA 7)
#
# Copie para `.env.local`. O Web SDK do projeto `synapsysnote` já vem preenchido
# (e também como fallback em `src/lib/firebase/config.ts`). O modo convidado da
# landing page continua local. Para forçar demonstração em toda a sessão:
# NEXT_PUBLIC_USE_LOCAL_DEMO=true
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase (cliente) — projeto `synapsysnote`
#    Estes valores são as chaves PÚBLICAS do Web SDK (não são segredo).
#    O acesso é barrado por Authorized domains + firestore.rules + storage.rules.
#    Para forçar o modo demonstração local: NEXT_PUBLIC_USE_LOCAL_DEMO=true
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCohAmoFuvjw-OXao3a_9yn0b-H22reprw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=synapsysnt.com.br
NEXT_PUBLIC_FIREBASE_PROJECT_ID=synapsysnote
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=synapsysnote.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=391599702512
NEXT_PUBLIC_FIREBASE_APP_ID=1:391599702512:web:f1948d41d3f63ad340dd35
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2ED1GY38CC
NEXT_PUBLIC_FIREBASE_REGION=southamerica-east1
# NEXT_PUBLIC_USE_LOCAL_DEMO=true

# Use os emuladores locais em vez do projeto real (firebase emulators:start).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Em produção o login fica no apex e o workspace no subdomínio.
# Deixe em branco no `next dev` para tudo rodar em localhost.
# NEXT_PUBLIC_LOGIN_ORIGIN=https://synapsysnt.com.br
# NEXT_PUBLIC_APP_ORIGIN=https://app.synapsysnt.com.br

# -----------------------------------------------------------------------------
# 1b. reCAPTCHA — caixa "Não sou um robô" no login e no esqueci a senha
#     Em localhost o app usa a chave de teste oficial do Google.
#     Em produção usa a chave do site abaixo + siteverify / CreateAssessment.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeOwqstAAAAAA43X5fUN0Ym5YI2Oq84kqxNPkVJ
RECAPTCHA_SECRET_KEY=

# App Check (reCAPTCHA Enterprise). Registre o app web em App Check no console,
# crie a chave e cole aqui; vazio desliga. Deixe em monitoramento alguns dias
# antes de exigir o App Check no Firestore e no Storage.
# NEXT_PUBLIC_APPCHECK_SITE_KEY=

# -----------------------------------------------------------------------------
# 2. Firebase Admin (servidor) — usado por todas as rotas /api/* que gravam
#    fora das regras do cliente (workspace, importações, mídia, lixeira, conta).
#    Console > Contas de serviço > Gerar chave. Cole o JSON inteiro em UMA linha.
#    Nunca deixe o arquivo .json da chave dentro do projeto em produção.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=synapsysnote.firebasestorage.app

# -----------------------------------------------------------------------------
# 3. Notion OAuth — https://www.notion.so/my-integrations
#    Crie uma Public connection com installation scope = Any workspace.
#    "Selected workspaces only" bloqueia contas de outros usuários (ex.: Tereza).
#    Redirect URI deve bater exatamente.
# -----------------------------------------------------------------------------
NOTION_CLIENT_ID=3d2d872b-594c-8149-8ea4-003714ed7827
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:43127/api/notion/callback

# -----------------------------------------------------------------------------
# 3b. Google Docs (opcional). Sem estas variáveis a conexão usa o popup do
#     Google (token de 1 hora, sem renovação). Com elas, o OAuth do servidor
#     guarda um refresh token criptografado. Em produção, o segredo vai por
#     firebase apphosting:secrets:set GOOGLE_CLIENT_SECRET e as três entram no
#     apphosting.yaml.
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:43127/api/google-docs/callback

# -----------------------------------------------------------------------------
# 4. Criptografia dos tokens de terceiros (AES-256-GCM)
#    Gere com: openssl rand -base64 32
#    Em produção: firebase apphosting:secrets:set TOKEN_ENCRYPTION_KEY
#    (as Cloud Functions não leem tokens de integração)
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 5. IA — rotas /api/ai/* do Next.js (flashcards e tradução; transcrição abaixo)
#    firebase apphosting:secrets:set GEMINI_API_KEY
#    A chave PRECISA ser de um projeto com faturamento ativo (nível pago): no
#    nível gratuito o Google pode usar o conteúdo enviado para melhorar os
#    produtos dele, o que contraria a Política de Privacidade.
#    A tradução usa a Cloud Translation API do projeto (ative a API e dê à
#    conta de serviço o papel "Cloud Translation API User"); enquanto ela não
#    estiver ativa, a rota usa a Gemini API.
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Transcrição de áudio e vídeo: Whisper no Groq (https://console.groq.com/keys).
# Plano gratuito: 7.200 s de áudio por hora, 28.800 s por dia (da conta
# inteira) e arquivos de até 25 MB. Em produção:
# firebase apphosting:secrets:set GROQ_API_KEY
# GROQ_API_KEY=
# Padrão whisper-large-v3-turbo; whisper-large-v3 é mais preciso e ~3x mais caro.
# GROQ_TRANSCRIBE_MODEL=
# EMBEDDING_MODEL=gemini-embedding-001
# Filtro semântico de flashcards repetidos: a geração compara os cards novos
# com os que a nota já tem. GEMINI_EMBEDDING_MODEL sobrescreve o modelo acima
# só para esse filtro; o limiar é a similaridade de cosseno a partir da qual
# dois cards contam como o mesmo (padrão 0.92, quanto menor mais agressivo).
# GEMINI_EMBEDDING_MODEL=
# GEMINI_DUPLICATE_THRESHOLD=0.92
# FUNCTIONS_REGION=southamerica-east1
# IMPORT_MAX_FILE_BYTES=262144000
# Idioma do site por país: o proxy lê primeiro cabeçalhos de CDN (x-gclb-country,
# cf-ipcountry, x-vercel-ip-country...). O App Hosting não envia nenhum, então,
# sem eles, o país vem de uma consulta GeoIP pelo IP do visitante, feita uma vez
# e guardada no cookie synapsys_geo por 30 dias. GEO_LOOKUP=off desliga a
# consulta (fica só o Accept-Language); GEO_LOOKUP_URL troca o serviço ({ip} é
# substituído, a resposta precisa trazer "country" em ISO-3166 alfa-2).
# GEO_LOOKUP=on
# GEO_LOOKUP_URL=https://api.country.is/{ip}
